# Copy this file to `.env` and adjust the values.
#   just config init    # creates .env from this file
#   just config check   # verifies the required variables are set
#   just config diff    # shows keys that differ from this file

# Application environment: development | staging | production
APP_ENV=development

# Database connection string (leave empty when DB_ENABLED=false)
DATABASE_URL=

# Toggle the `db` module. When false, db recipes no-op safely.
DB_ENABLED=false
